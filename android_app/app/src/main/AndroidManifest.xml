<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.skrozana.app">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.SKRozaanaBazaar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.screens.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.screens.MainActivity" />
        <activity android:name=".ui.screens.LoginActivity" />
        <activity android:name=".ui.screens.OtpVerificationActivity" />
        <activity android:name=".ui.screens.ProductListActivity" />
        <activity android:name=".ui.screens.CheckoutActivity" />
        <activity android:name=".ui.screens.OrderSuccessActivity" />
        <activity android:name=".ui.screens.OrderTrackingActivity" />
        <activity android:name=".ui.screens.RegisterActivity" />
        <activity android:name=".ui.screens.ProductDetailsActivity" />
        <activity android:name=".ui.screens.CartActivity" />
        <activity android:name=".ui.screens.ProfileActivity" />
        <activity android:name=".ui.screens.AddProductActivity" />

    </application>

</manifest>
