<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sk.rozaanabazaar">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.SKRozaanaBazaar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.home.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.home.MainActivity" />
        <activity android:name=".ui.home.OnboardingActivity" />
        <activity android:name=".ui.product.ProductSearchActivity" />
        <activity android:name=".ui.auth.LoginActivity" />
        <activity android:name=".ui.auth.OtpVerificationActivity" />
        <activity android:name=".ui.product.ProductListActivity" />
        <activity android:name=".ui.product.CheckoutActivity" />
        <activity android:name=".ui.product.OrderSuccessActivity" />
        <activity android:name=".ui.product.OrderTrackingActivity" />
        <activity android:name=".ui.auth.RegisterActivity" />
        <activity android:name=".ui.product.ProductDetailsActivity" />
        <activity android:name=".ui.product.CartActivity" />
        <activity android:name=".ui.product.AddressActivity" />
        <activity android:name=".ui.product.PaymentActivity" />
        <activity android:name=".ui.home.ProfileActivity" />
        <activity android:name=".ui.product.AddProductActivity" />

    </application>

</manifest>
